# Deployment mode: standalone or workspace
DEMO_MODE=standalone

# Complete OpenAI-compatible chat-completions endpoint
WSO2_GATEWAY_URL=https://localhost:8443/customer-ai-secure/chat/completions

# Inbound proxy API key. Keep this server-side and do not commit .env.
WSO2_SECURE_API_KEY=

# Local development only. Keep false for trusted production certificates.
WSO2_ALLOW_SELF_SIGNED=true

# Optional server settings
PORT=4174
WSO2_REQUEST_TIMEOUT_MS=30000
WSO2_DEFAULT_MODEL=gpt-4o-mini

# Local signed delegation context used only by agent-scope UI scenarios.
# Production deployments should rely on JWT/OAuth scopes in gateway AuthContext.
DEMO_DELEGATION_CONTEXT_SECRET=replace-this-local-delegation-secret

# Protected RAG lab — signed JWTs are minted and validated only on the server.
RAG_JWT_SECRET=replace-this-local-rag-jwt-secret
RAG_JWT_ISSUER=aurelius-bank-local
RAG_JWT_AUDIENCE=protected-ingestion
RAG_JWT_TTL_SECONDS=3600
RAG_TRUSTED_SOURCES=approved-knowledge-base,signed-policy-library
RAG_TRUSTED_EMAIL_DOMAINS=bank.example,aurelius.example
RAG_DATA_FILE=data/rag-security-lab.json

# HMAC signing used by the local demonstration.
RAG_DEMO_SIGNING_KEY_ID=knowledge-demo-key-1
RAG_DEMO_SIGNING_SECRET=replace-this-local-document-signing-secret
RAG_TRUSTED_SIGNING_KEYS=
RAG_REQUIRE_SIGNATURES=true

# Per-tenant, per-operation in-memory limits.
RAG_RATE_LIMIT_MAX=100
RAG_RATE_LIMIT_WINDOW_MS=60000

# Clearly labelled evaluator-limitation simulation. Keep false otherwise.
RAG_ALLOW_UNSAFE_SIMULATION=false

# Optional WSO2 Agent Manager / OTLP HTTP JSON export.
AGENT_MANAGER_OTLP_ENDPOINT=
AGENT_MANAGER_OTLP_HEADERS=
AGENT_MANAGER_TRACE_URL_TEMPLATE=
OTEL_SERVICE_NAME=aurelius-rag-security-lab
