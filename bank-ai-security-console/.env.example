# =============================================================================
# Aurelius Bank AI Security Console — AI Workspace configuration
# =============================================================================
#
# Copy this file to .env:
#
#   cp .env.example .env
#   chmod 600 .env
#
# Never commit the resulting .env file.
#
# The only value that must be copied from AI Workspace into this file is
# WSO2_SECURE_API_KEY. The gateway registration token and the upstream OpenAI
# provider key belong in their respective AI Workspace / gateway configurations,
# not in this console environment file.
# =============================================================================

# Deployment mode
DEMO_MODE=workspace

# Complete App LLM Proxy chat-completions endpoint.
# Replace localhost only when invoking a remotely reachable self-hosted gateway.
WSO2_GATEWAY_URL=https://localhost:8443/customer-ai-secure/v1/chat/completions

# App LLM Proxy API key generated or copied from AI Workspace.
WSO2_SECURE_API_KEY=

# Must match the App LLM Proxy inbound API-key authentication configuration.
WSO2_API_KEY_HEADER=X-API-Key

# Leave empty because the proxy expects the raw API key without a Bearer prefix.
WSO2_API_KEY_PREFIX=

# Local self-hosted gateway certificate only.
# Set to false when the gateway uses a certificate trusted by the host.
WSO2_ALLOW_SELF_SIGNED=true

# Console backend settings
PORT=4174
WSO2_REQUEST_TIMEOUT_MS=30000
WSO2_DEFAULT_MODEL=gpt-4o-mini

# =============================================================================
# Delegated agent authorization demo
# =============================================================================
#
# This value must exactly match demoContextHmacSecret configured for
# custom-agent-tool-scope-guardrail on the customer-ai-secure proxy.
#
# The default below is intentionally a public local-demo value.
# Replace it before exposing the demo beyond a controlled workstation.
DEMO_DELEGATION_CONTEXT_SECRET=aurelius-local-delegation-context-secret-change-me-2026

# =============================================================================
# Protected RAG lab
# =============================================================================
#
# These are local demonstration secrets and controls. Replace all secret values
# before using the lab outside a controlled demonstration environment.

RAG_MAX_FILE_BYTES=1048576

RAG_JWT_SECRET=replace-this-local-rag-jwt-secret-with-at-least-24-characters
RAG_JWT_ISSUER=aurelius-bank-local
RAG_JWT_AUDIENCE=protected-ingestion
RAG_JWT_TTL_SECONDS=3600

RAG_TRUSTED_SOURCES=approved-knowledge-base,signed-policy-library
RAG_TRUSTED_EMAIL_DOMAINS=bank.example,aurelius.example
RAG_DATA_FILE=data/rag-security-lab.json

RAG_DEMO_SIGNING_KEY_ID=knowledge-demo-key-1
RAG_DEMO_SIGNING_SECRET=replace-this-local-document-signing-secret-with-at-least-24-characters

# Optional additional trusted signing keys.
# Format: key-id=secret,key-id-2=secret-2
RAG_TRUSTED_SIGNING_KEYS=

RAG_REQUIRE_SIGNATURES=true
RAG_RATE_LIMIT_MAX=100
RAG_RATE_LIMIT_WINDOW_MS=60000

# Enables only the explicitly labelled evaluator-limitation simulation.
# Keep false outside a controlled demonstration.
RAG_ALLOW_UNSAFE_SIMULATION=false

# =============================================================================
# Optional WSO2 Agent Manager / OTLP export
# =============================================================================

# Complete OTLP HTTP traces endpoint, when enabled.
AGENT_MANAGER_OTLP_ENDPOINT=

# Comma-separated headers.
# Example:
# AGENT_MANAGER_OTLP_HEADERS=Authorization=Bearer replace-me,x-scope-orgid=my-org
AGENT_MANAGER_OTLP_HEADERS=

# Optional trace deep-link template. The UI replaces {traceId}.
AGENT_MANAGER_TRACE_URL_TEMPLATE=

OTEL_SERVICE_NAME=aurelius-rag-security-lab
